# Copiar a .env y completar con valores reales.
# .env está excluido de git (ver .gitignore) — nunca commitear credenciales reales.

# --- Base de datos SQL Server ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=YOUR_DB;encrypt=true;trustServerCertificate=false
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Credenciales HTTP Basic para proteger /api/** (obligatorias, sin valor por defecto) ---
APP_USER=
APP_PASSWORD=

# --- Límite de filas exportables por reporte completo (opcional) ---
EXPORT_MAX_ROWS=50000
