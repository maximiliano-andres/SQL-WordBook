# Copiar a .env y completar con valores reales.
# .env está excluido de git (ver .gitignore) — nunca commitear credenciales reales.

# --- Base de datos SQL Server ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=YOUR_DB;encrypt=true;trustServerCertificate=false
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Credenciales HTTP Basic para proteger /api/** (obligatorias, sin valor por defecto) ---
APP_USER=
APP_PASSWORD=

# --- Límite de filas exportables por reporte completo (opcional) ---
EXPORT_MAX_ROWS=50000
EXPORT_MAX_CONCURRENT=2

# =====================================================================
# Opcionales (seguridad y operación). Los valores por defecto mantienen
# el comportamiento habitual; descomentar solo lo que se quiera cambiar.
# =====================================================================

# --- Perfil: prod (detrás de proxy HTTPS) o dev (desarrollo local) ---
# SPRING_PROFILES_ACTIVE=prod

# --- Sesión (ISO 27002 8.5) ---
# SESSION_COOKIE_SECURE=true
# SESSION_IDLE_TIMEOUT=30m
# SESSION_MAX_LIFETIME=8h

# --- Conexiones dinámicas ("Cambiar conexión") ---
# Servidores permitidos; vacío = cualquiera. "sqlite" habilita archivos SQLite.
# DB_ALLOWED_HOSTS=db01.empresa.local,*.bd.empresa.local
# Obliga a validar el certificado TLS del servidor (ISO 27002 8.24)
# DB_REQUIRE_TLS_VALIDATION=true
# Tiempo máximo por consulta en segundos (0 = sin límite)
# DB_QUERY_TIMEOUT_SECONDS=120

# --- Privacidad (ISO 27002 8.11): columnas a mostrar como ****** ---
# APP_MASKED_COLUMNS=sueldo*,rut

# --- Orígenes extra aceptados en peticiones que modifican datos ---
# APP_ALLOWED_ORIGINS=http://localhost:5173

# --- Registro de auditoría (ISO 27002 8.15) ---
# AUDIT_LOG_DIR=logs
# AUDIT_LOG_MAX_HISTORY=365
